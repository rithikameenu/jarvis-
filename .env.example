# ============================================================
# FC-05 Real-Time Financial Fraud Detection Engine Environment Variables
# ============================================================

# Environment Mode: 'development' or 'production'
ENVIRONMENT=development

# Application Security
APP_NAME=FC-05-Fraud-Detection-Engine
API_V1_STR=/api/v1
SECRET_KEY=change-this-to-a-super-secret-hex-key-in-production-min-32-chars
JWT_SECRET=change-this-jwt-secret-key-in-production-must-be-strong
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration (PostgreSQL primary, SQLite fallback if Postgres unavailable)
DATABASE_URL=postgresql://fraud_user:fraud_pass@localhost:5432/fraud_detection_db
SQLITE_FALLBACK_URL=sqlite:///./fraud_detection.db

# CORS Configuration (Configured Frontend Origin, never '*' in production)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# API Rate Limiting (Requests per minute)
RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=10

# RAG & AI Configuration
CHROMA_PERSIST_DIR=./chroma_db
LLM_PROVIDER=mock_grounded
LLM_API_KEY=

# Demo Mode Settings
DEMO_MODE=true
DEMO_MFA_CODE=123456
